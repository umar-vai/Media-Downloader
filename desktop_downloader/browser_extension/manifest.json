{
  "manifest_version": 3,
  "name": "Media Downloader Browser Capture",
  "version": "1.3.2",
  "description": "IDM-style video download button with HLS quality selection for Media Downloader.",
  "permissions": ["storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_probe.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Media Downloader Browser Capture",
    "default_popup": "popup.html"
  }
}
